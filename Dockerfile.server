# syntax=docker/dockerfile:1.4
# Containerized goosed (goose-server) — exposes the goose agent HTTP API so you
# can drive goose from any HTTP client, script, or browser front-end without the
# Electron desktop app. This is the "headless backend" that the desktop UI talks
# to; running it in a container lets you point a browser/SPA or your own tooling
# at the same API.
#
#   docker compose up --build           # API on http://localhost:3000
#   curl -s -H "X-Secret-Key: $GOOSE_SERVER__SECRET_KEY" localhost:3000/agent/versions
#
# Built WITHOUT local-inference (llama-cpp) for a small, fast-building image.
# Cloud providers work out of the box — set GOOSE_PROVIDER / GOOSE_MODEL and the
# provider's API key (see docker-compose.yml).

# ---- build stage ------------------------------------------------------------
FROM rust:1-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    libdbus-1-dev \
    protobuf-compiler \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
# rust-toolchain.toml pins the exact channel; no local-inference keeps llama-cpp
# (and its C++ toolchain + image weight) out of the server image.
RUN cargo build --release -p goose-server --bin goosed \
    --no-default-features --features rustls-tls

# ---- runtime stage ----------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libdbus-1-3 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/goosed /usr/local/bin/goosed

RUN useradd -m -u 1000 -s /bin/bash goose
USER goose
WORKDIR /home/goose

# Bind on all interfaces inside the container so the published port is reachable.
ENV GOOSE_HOST=0.0.0.0 \
    GOOSE_PORT=3000
EXPOSE 3000

# GOOSE_SERVER__SECRET_KEY must be supplied at runtime (compose generates/forwards one).
ENTRYPOINT ["goosed"]
CMD ["agent"]

LABEL org.opencontainers.image.title="goosed" \
      org.opencontainers.image.description="goose agent server (headless HTTP API)" \
      org.opencontainers.image.vendor="88plug" \
      org.opencontainers.image.source="https://github.com/88plug/goose-plus"
